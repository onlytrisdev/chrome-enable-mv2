<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Mv2Enabler.Core</AssemblyName>
    <RootNamespace>Mv2Enabler</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Mv2Enabler\*.cs"
             Exclude="..\Mv2Enabler\Program.cs"
             Link="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\third-party\Iced.txt" Link="ThirdPartyNotices\Iced.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\docs\automatic-offsets.md" Link="docs\automatic-offsets.md"
          CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Iced" Version="1.21.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <InternalsVisibleTo Include="mv2ctl" />
    <InternalsVisibleTo Include="Mv2Enabler.Tests" />
    <InternalsVisibleTo Include="ChromeMv2Launcher" />
  </ItemGroup>
</Project>
