<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Mv2Enabler_Gui.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Mv2Enabler_Gui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="980" Padding="36,28,36,36" RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="7">
                    <TextBlock x:Name="HeroTitleText" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeroSubtitleText"
                               MaxWidth="720"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Top" Spacing="5">
                    <TextBlock x:Name="LanguageLabelText"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="LanguageComboBox"
                              MinWidth="150"
                              SelectionChanged="LanguageComboBox_SelectionChanged">
                        <ComboBoxItem Tag="vi" Content="Tiếng Việt" />
                        <ComboBoxItem Tag="en" Content="English" />
                        <ComboBoxItem Tag="zh-CN" Content="简体中文" />
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Padding="22"
                    Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="14">
                <Grid ColumnSpacing="18" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="AnalysisStatusDot"
                            Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                            Background="#FF9CA3AF"
                            CornerRadius="6" />
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock x:Name="AnalysisStatusText" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock x:Name="ChromeVersionText"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="—" />
                    </StackPanel>
                    <ProgressRing x:Name="BusyRing" Grid.Column="2" Width="24" Height="24" IsActive="True" />

                    <FontIcon Grid.Row="1" Glyph="&#xE8B7;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="ChromePathText"
                               Grid.Row="1"
                               Grid.Column="1"
                               Grid.ColumnSpan="2"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="chrome.exe"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Padding="18" Background="{StaticResource CardBackgroundBrush}" CornerRadius="12">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="BrowserStatusHeaderText" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border x:Name="ProcessStatusDot" Width="10" Height="10" VerticalAlignment="Center" Background="#FF9CA3AF" CornerRadius="5" />
                            <TextBlock x:Name="ProcessStatusText" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Padding="18" Background="{StaticResource CardBackgroundBrush}" CornerRadius="12">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="LaunchOptionsHeaderText" FontWeight="SemiBold" />
                        <CheckBox x:Name="OpenExtensionsCheckBox"
                                  IsChecked="True" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="3" Spacing="12">
                <Button x:Name="LaunchButton"
                        MinHeight="52"
                        HorizontalAlignment="Stretch"
                        Click="LaunchButton_Click"
                        IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10">
                        <FontIcon FontSize="18" Glyph="&#xE768;" />
                        <TextBlock x:Name="LaunchButtonText" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Click="RefreshButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" />
                            <TextBlock x:Name="RefreshButtonText" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="HintText"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </Grid>

                <InfoBar x:Name="ResultInfoBar" IsClosable="True" IsOpen="False" />
            </StackPanel>

            <Expander x:Name="TechnicalDetailsExpander" Grid.Row="4" IsExpanded="False">
                <Border Margin="0,8,0,0" Padding="16" Background="{StaticResource AccentSoftBrush}" CornerRadius="10">
                    <TextBox x:Name="DetailsTextBox"
                             AcceptsReturn="True"
                             Background="Transparent"
                             BorderThickness="0"
                             FontFamily="Cascadia Mono"
                             FontSize="12"
                             IsReadOnly="True"
                             IsTabStop="False"
                             TextWrapping="Wrap" />
                </Border>
            </Expander>
        </Grid>
    </ScrollViewer>
</Page>
