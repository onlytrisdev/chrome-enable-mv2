{
  "manifest_version": 2,
  "name": "MV2 Gate Smoke Test",
  "version": "1.0.0",
  "key": "",
  "description": "A local extension used to verify that the Chrome MV2 gate is open.",
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Manifest V2 is running"
  },
  "permissions": [
    "storage",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["https://example.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
